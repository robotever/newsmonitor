<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.robot-ever.newsmonitor.market-dashboard</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>__WRAPPER__</string></array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <key>EnvironmentVariables</key><dict>
    <key>MARKET_DASHBOARD_PROJECT_ROOT</key><string>__PROJECT_ROOT__</string>
    <key>MARKET_DASHBOARD_PYTHON</key><string>__PYTHON__</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><false/>
  <key>KeepAlive</key><false/>
  <key>ProcessType</key><string>Background</string>
  <key>Umask</key><integer>63</integer>
  <key>StandardOutPath</key><string>__LOG_DIR__/launchd.log</string>
  <key>StandardErrorPath</key><string>__LOG_DIR__/launchd.log</string>
</dict>
</plist>
